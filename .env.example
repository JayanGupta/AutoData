# AutoData - deployment environment variables
#
# Local development: these are all optional. The app runs out of the box with
# sensible defaults (backend on :8000, frontend proxying /api to it).

# --- Backend (FastAPI) ---
# Comma-separated allowed CORS origins. "*" allows all (default).
# CORS_ORIGINS=*

# Where the SQLite session database lives. Defaults to backend/app/data.
# On Render set this to a persistent disk mount (see render.yaml).
# AUTODATA_DATA_DIR=/opt/data

# Optional LLM (user-supplied credentials only - never commit real keys).
# Without these the app runs in fully local rule-based mode.
# USER_LLM_API_KEY=
# USER_LLM_BASE_URL=https://api.deepseek.com/v1
# USER_LLM_MODEL=deepseek-chat

# --- Frontend (Next.js) ---
# URL of the backend that the Next.js server proxies /api requests to.
# Defaults to http://127.0.0.1:8000 for local dev. On Render this is set
# automatically from the backend service's public URL (see render.yaml).
# BACKEND_URL=http://127.0.0.1:8000

# Optional: if set, the browser calls the backend directly instead of using
# the server-side proxy. Must include the full origin AND the /api prefix,
# e.g. https://backend.onrender.com/api
# NEXT_PUBLIC_API_BASE=https://backend.onrender.com/api
